# Neo4j connection. For AuraDB Free use the neo4j+s:// URI from the credentials file you downloaded.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Local Neo4j instead (Docker or Desktop):
# NEO4J_URI=bolt://localhost:7687

# Allowed website origins for the API (comma-separated). Add your Vercel URL when you deploy.
CORS_ORIGINS=http://localhost:5173

# 1 = enables the "Reset demo data" button / POST /admin/reseed. Set to 0 on a public deployment.
ENABLE_ADMIN=1
MAX_HIERARCHY_DEPTH=8
